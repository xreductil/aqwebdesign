{
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/Patriasample/Patria/index.html",
      "destination": "/"
    },
    {
      "source": "/admin",
      "destination": "/admin/signin.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin/signin.html"
    }
  ]
}
