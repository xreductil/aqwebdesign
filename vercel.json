{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": ".",
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*\\.(webp|png|jpg|jpeg|svg|woff2?|ttf))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.(css|js))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*\\.(html))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/Patriasample/Patria/dist/liff-login.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/liff-login.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://www.aq-webdesign.com/api/:path*"
    },
    {
      "source": "/auth/line",
      "destination": "https://www.aq-webdesign.com/auth/line"
    },
    {
      "source": "/auth/line/:path*",
      "destination": "https://www.aq-webdesign.com/auth/line/:path*"
    },
    {
      "source": "/images/:path*",
      "destination": "https://www.aq-webdesign.com/images/:path*"
    },
    {
      "source": "/Patriasample/Patria/dist/liff-login.html",
      "destination": "/liff-login.html"
    },
    {
      "source": "/Patriasample/Patria/index.html",
      "destination": "/Patriasample/Patria/dist/index.html"
    },
    {
      "source": "/admin",
      "destination": "/Patriasample/dashboardsample/dist/signin.html"
    },
    {
      "source": "/admin/",
      "destination": "/Patriasample/dashboardsample/dist/signin.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/Patriasample/dashboardsample/dist/:path*"
    }
  ]
}
