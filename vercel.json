{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": ".vercel-site",
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/about.html",
      "destination": "/about/",
      "permanent": true
    },
    {
      "source": "/services.html",
      "destination": "/services/",
      "permanent": true
    },
    {
      "source": "/enterprise-website-design.html",
      "destination": "/enterprise-website-design/",
      "permanent": true
    },
    {
      "source": "/ecommerce-website-design.html",
      "destination": "/ecommerce-website-design/",
      "permanent": true
    },
    {
      "source": "/seo.html",
      "destination": "/seo/",
      "permanent": true
    },
    {
      "source": "/brand-strategy.html",
      "destination": "/brand-strategy/",
      "permanent": true
    },
    {
      "source": "/ui-ux-design.html",
      "destination": "/ui-ux-design/",
      "permanent": true
    },
    {
      "source": "/portfolio.html",
      "destination": "/portfolio/",
      "permanent": true
    },
    {
      "source": "/portfolio-examples.html",
      "destination": "/portfolio/",
      "permanent": true
    },
    {
      "source": "/blog.html",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/blog-api-key-security.html",
      "destination": "/blog-api-key-security/",
      "permanent": true
    },
    {
      "source": "/contact.html",
      "destination": "/contact/",
      "permanent": true
    },
    {
      "source": "/corporate-website-design.html",
      "destination": "/enterprise-website-design/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/Patriasample/Patria/dist/liff-login.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/liff-login.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/blog-api-key-security.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/blog-api-key-security/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/about/",
      "destination": "/about.html"
    },
    {
      "source": "/services/",
      "destination": "/services.html"
    },
    {
      "source": "/enterprise-website-design/",
      "destination": "/enterprise-website-design.html"
    },
    {
      "source": "/ecommerce-website-design/",
      "destination": "/ecommerce-website-design.html"
    },
    {
      "source": "/seo/",
      "destination": "/seo.html"
    },
    {
      "source": "/brand-strategy/",
      "destination": "/brand-strategy.html"
    },
    {
      "source": "/ui-ux-design/",
      "destination": "/ui-ux-design.html"
    },
    {
      "source": "/portfolio/",
      "destination": "/portfolio.html"
    },
    {
      "source": "/blog/",
      "destination": "/blog.html"
    },
    {
      "source": "/blog-api-key-security/",
      "destination": "/blog-api-key-security.html"
    },
    {
      "source": "/contact/",
      "destination": "/contact.html"
    },
    {
      "source": "/api/:path*",
      "destination": "https://www.aq-webdesign.com/api/:path*"
    },
    {
      "source": "/auth/line",
      "destination": "https://www.aq-webdesign.com/auth/line"
    },
    {
      "source": "/auth/line/:path*",
      "destination": "https://www.aq-webdesign.com/auth/line/:path*"
    },
    {
      "source": "/Patriasample/Patria/dist/liff-login.html",
      "destination": "/liff-login.html"
    },
    {
      "source": "/Patriasample/Patria/index.html",
      "destination": "/Patriasample/Patria/dist/index.html"
    },
    {
      "source": "/admin",
      "destination": "/Patriasample/dashboardsample/dist/signin.html"
    },
    {
      "source": "/admin/",
      "destination": "/Patriasample/dashboardsample/dist/signin.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/Patriasample/dashboardsample/dist/:path*"
    }
  ]
}
