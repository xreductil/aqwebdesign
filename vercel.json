{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "site",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/latest-news/article/:path*",
      "destination": "https://sensen.jinfeng8605.workers.dev/latest-news/article/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://sensen.jinfeng8605.workers.dev/api/:path*"
    },
    {
      "source": "/images/:path*",
      "destination": "https://sensen.jinfeng8605.workers.dev/images/:path*"
    },
    {
      "source": "/health",
      "destination": "https://sensen.jinfeng8605.workers.dev/health"
    }
  ]
}
