{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": ".vercel-site",
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/blog-api-key-security.html",
      "destination": "/blog-api-key-security/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/Patriasample/Patria/dist/liff-login.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/liff-login.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/blog-api-key-security.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/blog-api-key-security/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/blog-api-key-security/",
      "destination": "/blog-api-key-security.html"
    },
    {
      "source": "/api/:path*",
      "destination": "https://www.aq-webdesign.com/api/:path*"
    },
    {
      "source": "/auth/line",
      "destination": "https://www.aq-webdesign.com/auth/line"
    },
    {
      "source": "/auth/line/:path*",
      "destination": "https://www.aq-webdesign.com/auth/line/:path*"
    },
    {
      "source": "/Patriasample/Patria/dist/liff-login.html",
      "destination": "/liff-login.html"
    },
    {
      "source": "/Patriasample/Patria/index.html",
      "destination": "/Patriasample/Patria/dist/index.html"
    },
    {
      "source": "/admin",
      "destination": "/Patriasample/dashboardsample/dist/signin.html"
    },
    {
      "source": "/admin/",
      "destination": "/Patriasample/dashboardsample/dist/signin.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/Patriasample/dashboardsample/dist/:path*"
    }
  ]
}
